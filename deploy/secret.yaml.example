# Single shared cluster-wide Retyc identity (POC scoping decision — see the plan). Copy this
# file, fill in real values, and apply it yourself; it's excluded from `make deploy` on purpose.
#
# RETYC_TOKEN: mint once with `retyc auth login --offline` (long-lived offline refresh token).
# RETYC_KEY_PASSPHRASE: the passphrase that unlocks this account's AGE identity.
apiVersion: v1
kind: Secret
metadata:
  name: retyc-csi-credentials
  namespace: kube-system
type: Opaque
stringData:
  RETYC_TOKEN: "replace-with-offline-token"
  RETYC_KEY_PASSPHRASE: "replace-with-key-passphrase"
